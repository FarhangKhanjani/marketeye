rules_version = '2';
// Paste into Firebase console -> Firestore Database -> Rules, then Publish.
// Each logged-in user can read and write only their own saved searches. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/searches/{searchId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.size() < 20
                    && request.resource.data.keys().hasAll(["fetched_at", "settings", "long", "short", "outliers"]);
    }
  }
}
